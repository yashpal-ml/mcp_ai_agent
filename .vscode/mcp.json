{
	"servers": {
		"mcp-ai-agent": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"servers/basic_mcp_stdio.py"
			]
		},
		"mcp-ai-agent-http": {
			"type": "http",
			"url": "http://localhost:8000/mcp"
		},
		"mcp-ai-agent-debug": {
			"type": "stdio",
			"command": "uv",
			"cwd": "${workspaceFolder}",
			"args": [
				"run",
				"--",
				"python",
				"-m",
				"debugpy",
				"--listen",
				"0.0.0.0:5678",
				"servers/basic_mcp_stdio.py"
			]
		}
		
	},
	"inputs": []
}